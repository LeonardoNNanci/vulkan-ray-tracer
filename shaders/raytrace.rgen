#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_debug_printf : enable

#include "raycommon.glsl"
#include "random.glsl"

layout(location = 0) rayPayloadEXT hitPayload prd;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 4) buffer _buff { float rgbBuffer[]; };
layout(set = 0, binding = 5) buffer _buf1 { float albedoBuffer[]; };
layout(set = 0, binding = 6) buffer _buf2 { float normalBuffer[]; };

layout(set = 2, binding = 0) uniform UBO {
    mat4 currProj;
	mat4 currProjInv;
	mat4 currView;
	mat4 currViewInv;
} ubo;

layout(push_constant) uniform constants {
    float timestamp;
    int frame;
};

uint  rayFlags = gl_RayFlagsNoneEXT;
float tMin     = 0.00001;
float tMax     = 10000.0;

void fillBuffers(ivec2 pixel){
    uint linear = pixel.y * gl_LaunchSizeEXT.x * 3 + pixel.x * 3;

    albedoBuffer[linear] = prd.albedo.r;
    albedoBuffer[linear + 1] = prd.albedo.g;
    albedoBuffer[linear + 2] = prd.albedo.b;

    normalBuffer[linear] = prd.normal.x;
    normalBuffer[linear + 1] = prd.normal.y;
    normalBuffer[linear + 2] = prd.normal.z;

    rgbBuffer[linear] = 0.;
    rgbBuffer[linear + 1] = 0.;
    rgbBuffer[linear + 2] = 0.;
}

void prePass(ivec2 pixel){
    vec2 inUV = (vec2(pixel) + vec2(0.5)) / vec2(gl_LaunchSizeEXT.xy);
    vec2 d = inUV * 2.0 - 1.0;

    vec3 origin    = (ubo.currViewInv * vec4(0, 0, 0, 1)).xyz;
    vec3 target    = (ubo.currProjInv * vec4(d.x, d.y, 1, 1)).xyz;
    vec3 direction = (ubo.currViewInv * vec4(normalize(target), 0)).xyz;

    prd.fillGuideLayers = true;
    prd.hitValue = vec3(0.);
    prd.depth = 0;
    prd.albedo = vec3(0.);
    prd.normal = vec3(0.);
    
    traceRayEXT(topLevelAS, // acceleration structure
        rayFlags,       // rayFlags
        0xFF,           // cullMask
        0,              // sbtRecordOffset
        0,              // sbtRecordStride
        0,              // missIndex
        origin,  // ray origin
        tMin,           // ray min range
        direction,  // ray direction
        tMax,           // ray max range
        0               // payload (location = 0)
    );
    prd.fillGuideLayers = false;

    fillBuffers(pixel);
}

vec3 rayTrace(ivec2 pixel, int i){
    vec2 offset = vec2(rnd(prd.seed), rnd(prd.seed)) - vec2(.5);
    vec2 targetCoords = vec2(pixel) + offset;
    vec2 inUV = targetCoords / vec2(gl_LaunchSizeEXT.xy);
    vec2 d = inUV * 2.0 - 1.0;

    vec3 origin    = (ubo.currViewInv * vec4(0, 0, 0, 1)).xyz;
    vec3 target    = (ubo.currProjInv * vec4(d.x, d.y, 1, 1)).xyz;
    vec3 direction = (ubo.currViewInv * vec4(normalize(target), 0)).xyz;

    prd.hitValue = vec3(0.);
    prd.depth = 0;

    traceRayEXT(topLevelAS, // acceleration structure
        rayFlags,       // rayFlags
        0xFF,           // cullMask
        0,              // sbtRecordOffset
        0,              // sbtRecordStride
        0,              // missIndex
        origin,  // ray origin
        tMin,           // ray min range
        direction,  // ray direction
        tMax,           // ray max range
        0               // payload (location = 0)
    );
    return prd.hitValue;
}

void main() 
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);

    prePass(pixel);

    prd.depth = 0;
    prd.seed = tea(gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x, uint(timestamp * 10e10));
    int sampleCount = 1;
    vec3 finalColor = vec3(0.);
    for(int i = 0; i < sampleCount; i++){
        prd.seed += i;
        finalColor += rayTrace(pixel, i);
    }
    finalColor = finalColor / float(sampleCount);

    // gamma correction
    uint linear = pixel.y * gl_LaunchSizeEXT.x * 3 + pixel.x * 3;
    rgbBuffer[linear] = sqrt(finalColor.r);
    rgbBuffer[linear + 1] = sqrt(finalColor.g);
    rgbBuffer[linear + 2] = sqrt(finalColor.b);
}
