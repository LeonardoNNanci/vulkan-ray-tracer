#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_debug_printf : enable

#include "raycommon.glsl"

layout(location = 0) rayPayloadEXT hitPayload prd;

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 4) buffer _buff { float rgbBuffer[]; };
layout(set = 0, binding = 5) buffer _buf1 { float albedoBuffer[]; };
layout(set = 0, binding = 6) buffer _buf2 { float normalBuffer[]; };
//layout(set = 0, binding = 8) buffer _buff2 { Range foveatedRangeBuffer[];};

layout(push_constant) uniform constants {
    mat4 proj;
    mat4 projInv;
    mat4 view;
    mat4 viewInv;
};

uint  rayFlags = gl_RayFlagsOpaqueEXT;
float tMin     = 0.00001;
float tMax     = 10000.0;

// float calcRatio(ivec2 pixel){
//     ivec2 imageCenter = ivec2(gl_LaunchSizeEXT.xy) / 2;
//     float dist = length(pixel - imageCenter);

//     float innerRatio = foveatedRangeBuffer[0].ratio;
//     float outerRatio = foveatedRangeBuffer[1].ratio;

//     float innerRadius = foveatedRangeBuffer[0].outerRadius;
//     float outerRadius = foveatedRangeBuffer[1].innerRadius;

