#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_debug_printf : enable

#include "raycommon.glsl"

layout(location = 0) rayPayloadEXT hitPayload prd;

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 4) buffer _buff { float rgbBuffer[]; };
layout(set = 0, binding = 5) buffer _buf1 { float albedoBuffer[]; };
layout(set = 0, binding = 6) buffer _buf2 { float normalBuffer[]; };
layout(set = 0, binding = 8) buffer _buff2 { Range foveatedRangeBuffer[];};

layout(push_constant) uniform constants {
    mat4 proj;
    mat4 projInv;
    mat4 view;
    mat4 viewInv;
};

int ratioCount = 3;
uint  rayFlags = gl_RayFlagsOpaqueEXT;
float tMin     = 0.00001;
float tMax     = 10000.0;

float calcRatio(ivec2 pixel){
    ivec2 imageCenter = ivec2(gl_LaunchSizeEXT.xy) / 2;
    float dist = length(pixel - imageCenter);
    float ratio;
    for(int i = 0; i < ratioCount; i++){
        Range r = foveatedRangeBuffer[i];
        if(dist >= r.innerRadius && dist < r.outerRadius){
            ratio = r.ratio;
            break;
        }
        Range nextR = foveatedRangeBuffer[i+1];
        if(dist >= r.outerRadius && dist < nextR.innerRadius){
            ratio = (dist - r.outerRadius) / (nextR.innerRadius - r.outerRadius);
            ratio *= (nextR.ratio - r.ratio);
            ratio += r.ratio;
            break;
        }
    }

    return ratio;
}

void fillBuffers(ivec2 pixel){
    uint linear = pixel.y * gl_LaunchSizeEXT.x * 3 + pixel.x * 3;

    albedoBuffer[linear] = prd.albedo.r;
    albedoBuffer[linear + 1] = prd.albedo.g;
    albedoBuffer[linear + 2] = prd.albedo.b;

    normalBuffer[linear] = prd.normal.x;
    normalBuffer[linear + 1] = prd.normal.y;
    normalBuffer[linear + 2] = prd.normal.z;

    rgbBuffer[linear] = 0.;
    rgbBuffer[linear + 1] = 0.;
    rgbBuffer[linear + 2] = 0.;
}

void prePass(ivec2 pixel){
    vec2 inUV = (vec2(pixel) + vec2(0.5)) / vec2(gl_LaunchSizeEXT.xy);
    vec2 d = inUV * 2.0 - 1.0;

    vec3 origin    = (viewInv * vec4(0, 0, 0, 1)).xyz;
    vec3 target    = (projInv * vec4(d.x, d.y, 1, 1)).xyz;
    vec3 direction = (viewInv * vec4(normalize(target), 0)).xyz;

    prd.fillGuideLayers = true;
    prd.hitValue = vec3(0.);
    prd.depth = 0;
    
    traceRayEXT(topLevelAS, // acceleration structure
        rayFlags,       // rayFlags
        0xFF,           // cullMask
        0,              // sbtRecordOffset
        0,              // sbtRecordStride
        0,              // missIndex
        origin,  // ray origin
        tMin,           // ray min range
        direction,  // ray direction
        tMax,           // ray max range
        0               // payload (location = 0)
    );
    prd.fillGuideLayers = false;

    fillBuffers(pixel);
}

vec3 rayTrace(ivec2 pixel, int i){
    vec2 targetCoords = vec2(pixel) + rand3(i).xy / 2.;
    vec2 inUV = targetCoords / vec2(gl_LaunchSizeEXT.xy);
    vec2 d = inUV * 2.0 - 1.0;

    vec3 origin    = (viewInv * vec4(0, 0, 0, 1)).xyz;
    vec3 target    = (projInv * vec4(d.x, d.y, 1, 1)).xyz;
    vec3 direction = (viewInv * vec4(normalize(target), 0)).xyz;

    prd.hitValue = vec3(0.);
    prd.depth = 0;

    traceRayEXT(topLevelAS, // acceleration structure
        rayFlags,       // rayFlags
        0xFF,           // cullMask
        0,              // sbtRecordOffset
        0,              // sbtRecordStride
        0,              // missIndex
        origin,  // ray origin
        tMin,           // ray min range
        direction,  // ray direction
        tMax,           // ray max range
        0               // payload (location = 0)
    );
    return prd.hitValue;
}

void main() 
{
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);

    prePass(pixel);

    float ratio = calcRatio(pixel);
    float p = rand(vec2(pixel)) / 2 + 0.5;
    if(p > 1. / ratio)
        return;

    prd.depth = 0;

    int maxDepth = 32;
    int sampleCount = 1;
    vec3 finalColor = vec3(0.);
    for(int i = 0; i < sampleCount; i++){
        finalColor += rayTrace(pixel, i);
    }
    finalColor /= float(sampleCount);
    finalColor *= ratio;

    uint linear = pixel.y * gl_LaunchSizeEXT.x * 3 + pixel.x * 3;
    rgbBuffer[linear] = finalColor.r;
    rgbBuffer[linear + 1] = finalColor.g;
    rgbBuffer[linear + 2] = finalColor.b;
}
